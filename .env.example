# Embaixadores Acorde Sua Mente
# Copie para .env e preencha. NUNCA commite segredos.

# --- App ---
NODE_ENV=production
PORT=3000
APP_BASE_URL=https://embaixadores.iamcontrol.com.br
CORS_ORIGIN=https://embaixadores.iamcontrol.com.br
DEMO_MODE=false

# --- Supabase (gerenciado) ---
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Frontend (build-time / Vite)
VITE_SUPABASE_URL=https://[PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Criptografia de tokens sociais (32 bytes em hex = 64 chars) ---
# Gere com: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Instagram (Meta) — pendente até criar o app ---
META_APP_ID=
META_APP_SECRET=
# Callback: ${APP_BASE_URL}/api/social/oauth/instagram/callback

# --- TikTok — pendente até criar o app e aprovar Login Kit + Display API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Callback: ${APP_BASE_URL}/api/social/oauth/tiktok/callback

# --- Sync defaults (também em app_settings no banco) ---
SYNC_INTERVAL_MINUTES=60
STALE_TOLERANCE_HOURS=24
MANUAL_SYNC_COOLDOWN_SECONDS=300
